# OpenRouter API Key for AI Analysis (Optional, falls back to mocks if empty)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1
DATABASE_URL=postgresql+asyncpg://finsight:finsight@localhost:5432/finsight
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
RUN_SNAPSHOT_JOBS=true
CORS_ORIGINS=http://localhost:3000
MARKET_PROVIDER=csv
INSTALL_VNSTOCK=false
VNSTOCK_SYMBOLS=VCB,ACB,MBB,BID,FPT,CMG,SSI,VRE,DXG,PVD,POW,GAS,HPG,SAB,KDC
VNSTOCK_REQUEST_DELAY_SECONDS=6
NEWS_FEED_ENABLED=true
JWT_SECRET=replace_with_a_random_256_bit_secret
VNSTOCK_API_KEY=
